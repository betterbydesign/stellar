---
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  currentPage: 'home' | 'contact';
}

const { title, description, currentPage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" />
    <title>{title} · Fieldnote Studio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Fieldnote Studio home">
          <span class="wordmark__symbol" aria-hidden="true">✳</span>
          <span>fieldnote<span class="wordmark__dot">.</span></span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/" aria-current={currentPage === 'home' ? 'page' : undefined}>Home</a>
          <a href="/contact/" aria-current={currentPage === 'contact' ? 'page' : undefined}>Contact</a>
        </nav>
        <a class="header-link" href="/contact/">Start a project <span aria-hidden="true">↗</span></a>
      </header>

      <main id="main"><slot /></main>

      <footer class="site-footer">
        <div>
          <a class="wordmark wordmark--footer" href="/" aria-label="Fieldnote Studio home">
            <span class="wordmark__symbol" aria-hidden="true">✳</span>
            <span>fieldnote<span class="wordmark__dot">.</span></span>
          </a>
          <p>Thoughtful design for what comes next.</p>
        </div>
        <div class="site-footer__end">
          <a href="/contact/">Let’s make something useful <span aria-hidden="true">↗</span></a>
          <small>© Fieldnote Studio</small>
        </div>
      </footer>
    </div>
  </body>
</html>
