# Local launcher mode needs no provider credentials. Keep platform mode off for it.
STELLAR_PLATFORM_MODE=0

# Platform development: set these in apps/web/.env.local (never commit that file).
# Use a Stellar-owned development WorkOS application and Convex deployment.
# STELLAR_PLATFORM_MODE=1
# WORKOS_CLIENT_ID=client_example
# WORKOS_API_KEY=sk_test_example
# WORKOS_COOKIE_PASSWORD=your_unique_random_32_or_more_character_password
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:43110/auth/callback
# NEXT_PUBLIC_CONVEX_URL=https://example.convex.cloud
# Configure matching callback and sign-out URLs in WorkOS.
# WORKOS_CLIENT_ID must also be set on the Convex deployment.
# Do not combine STELLAR_PLATFORM_MODE=1 with STELLAR_LOCAL_MODE=1.
